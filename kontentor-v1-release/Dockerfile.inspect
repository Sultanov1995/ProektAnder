FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tar gzip grep findutils sed && rm -rf /var/lib/apt/lists/*
WORKDIR /bootstrap
COPY source.tgz /tmp/kontentor-source.tgz
RUN mkdir -p /app && tar -xzf /tmp/kontentor-source.tgz -C /app
RUN echo "===KONTENTOR_TREE===" && find /app -maxdepth 5 -type f | sort | sed 's#^/app/##' | head -n 500
RUN echo "===PACKAGE_JSON===" && cat /app/package.json
RUN echo "===AI_TELEGRAM_MATCHES===" && grep -R -n -E "OPENAI|OpenAI|openai|MTProto|mtproto|Telegram|telegram|analy(z|s)" /app --exclude-dir=node_modules --exclude='*.map' | head -n 1200 || true
RUN echo "===END_INSPECTION==="
CMD ["sh","-c","sleep infinity"]
