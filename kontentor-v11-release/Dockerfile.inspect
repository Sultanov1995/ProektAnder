FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tar gzip && rm -rf /var/lib/apt/lists/*
WORKDIR /bootstrap
COPY source.tgz /tmp/kontentor-source.tgz
RUN mkdir -p /app && tar -xzf /tmp/kontentor-source.tgz -C /app
RUN node -e "const fs=require('fs'); for (const p of ['.env.example','lib/openai.ts','lib/mtproto.ts','scripts/create-telegram-session.mjs','app/api/analytics/analyze/route.ts','app/api/mtproto/stats/route.ts','lib/channel-analysis.ts','components/ChannelAnalysisPanel.tsx']) console.log('@@FILE@@'+p+'@@'+JSON.stringify(fs.readFileSync('/app/'+p,'utf8')))"
CMD ["sh","-c","sleep infinity"]
